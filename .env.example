# Optional build-time credentials for a self-hosted deploy.
# Copy to ".env" and fill in to skip typing them into the Settings panel.
# Leave blank to run in demo mode (or enter them in-app at runtime).

# YouTube Data API v3 key — enables real search & playback.
VITE_YT_API_KEY=

# Google OAuth 2.0 Client ID — enables syncing playlists to your account
# (they appear in YouTube Music). Must list this app's origin under
# "Authorized JavaScript origins".
VITE_YT_OAUTH_CLIENT_ID=
